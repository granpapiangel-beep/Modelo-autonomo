name: Actualizador Nocturno NBA

on:
  schedule:
    # Se ejecuta automáticamente todos los días a las 06:00 UTC (madrugada)
    - cron: '0 6 * * *'
  workflow_dispatch: # Te permite también dispararlo de forma manual cuando quieras desde GitHub

jobs:
  actualizar_datos:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Clonar repositorio
        uses: actions/checkout@v3

      - name: Configurar entorno Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Instalar dependencias necesarias
        run: pip install pandas requests

      - name: Ejecutar script de extracción y análisis
        run: python actualizador_nocturno.py

      - name: Guardar y commitear cambios en el repositorio
        run: |
          git config --global user.name "Bot Autónomo NBA"
          git config --global user.email "bot@users.noreply.github.com"
          git add partidos_historicos_nba.csv
          git commit -m "Actualización automática de patrones y estadísticas nocturnas [skip ci]" || exit 0
          git push
